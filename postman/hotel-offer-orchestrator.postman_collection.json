{
  "info": {"name":"Hotel Offer Orchestrator","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:3000"}],
  "item":[
    {"name":"Delhi best offers","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('status is 200',()=>pm.response.to.have.status(200));","const rows=pm.response.json();","pm.test('Holtin winner and price',()=>pm.expect(rows.find(x=>x.name==='Holtin')).to.include({price:5340,supplier:'Supplier B'}));","pm.test('Radison winner and price',()=>pm.expect(rows.find(x=>x.name==='Radison')).to.include({price:5900,supplier:'Supplier A'}));","pm.test('unique hotel names',()=>pm.expect(new Set(rows.map(x=>x.name.toLowerCase())).size).to.eql(rows.length));","pm.test('ascending prices',()=>pm.expect(rows.map(x=>x.price)).to.eql([...rows.map(x=>x.price)].sort((a,b)=>a-b)));","pm.test('exact response fields',()=>rows.forEach(x=>pm.expect(Object.keys(x).sort()).to.eql(['commissionPct','name','price','supplier'])));"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/hotels?city=delhi"}},
    {"name":"Redis inclusive price range","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('status is 200',()=>pm.response.to.have.status(200));","pm.test('all prices are inclusive 4000 to 6000',()=>pm.response.json().forEach(x=>pm.expect(x.price).to.be.within(4000,6000)));","pm.test('range served from redis or newly refreshed workflow',()=>pm.expect(['redis','workflow']).to.include(pm.response.headers.get('X-Source')));"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/hotels?city=delhi&minPrice=4000&maxPrice=6000"}},
    {"name":"Unknown city returns empty","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('status 200 with empty list',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json()).to.eql([])});"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/hotels?city=paris"}},
    {"name":"Reversed bounds rejected","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('400 INVALID_QUERY',()=>{pm.response.to.have.status(400);pm.expect(pm.response.json().error.code).to.eql('INVALID_QUERY')});"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/hotels?city=delhi&minPrice=9000&maxPrice=100"}},
    {"name":"Supplier A mock","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Supplier A returns records',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json()[0]).to.have.keys('hotelId','name','price','city','commissionPct')});"]}}],"request":{"method":"GET","url":"{{baseUrl}}/supplierA/hotels?city=delhi"}},
    {"name":"Supplier B mock","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Supplier B returns records',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json()[0]).to.have.keys('hotelId','name','price','city','commissionPct')});"]}}],"request":{"method":"GET","url":"{{baseUrl}}/supplierB/hotels?city=delhi"}},
    {"name":"Health is ready","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('healthy dependencies',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().checks.supplierA).to.eql('up');pm.expect(pm.response.json().checks.supplierB).to.eql('up')});"]}}],"request":{"method":"GET","url":"{{baseUrl}}/health"}},
    {"name":"Take Supplier B down","request":{"method":"POST","url":"{{baseUrl}}/api/admin/suppliers/B/down"}},
    {"name":"Partial result while Supplier B is down","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('partial data succeeds and is flagged',()=>{pm.response.to.have.status(200);pm.expect(pm.response.headers.get('X-Degraded')).to.include('Supplier B');pm.expect(pm.response.json().every(x=>x.supplier==='Supplier A')).to.eql(true)});"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/hotels?city=delhi"}},
    {"name":"Health shows Supplier B down","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('degraded health is 503',()=>{pm.response.to.have.status(503);pm.expect(pm.response.json().checks.supplierB).to.eql('down')});"]}}],"request":{"method":"GET","url":"{{baseUrl}}/health"}},
    {"name":"Restore Supplier B","request":{"method":"POST","url":"{{baseUrl}}/api/admin/suppliers/B/up"}}
  ]
}
